HOST=127.0.0.1
PORT=8002
# Use a secret shared ONLY by your Laravel/backend server, never a public extension.
API_KEY=
DATA_DIR=./data
MAX_JOBS=200
MAX_UPLOAD_MB=20
MAX_PIXELS=12000000
CPU_THREADS=4
JOB_TIMEOUT_SECONDS=180
RESULT_TTL_HOURS=24
# Browser origins allowed to call this API directly, comma-separated; empty = same-origin only.
CORS_ORIGINS=
